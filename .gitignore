# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust related
/rust/target/
**/*.rs.bk

# ROMs and saves
*.gb
*.gbc
*.sav
*.srm
*.state

# Android local and signing files
**/local.properties
**/key.properties
**/*.keystore
**/*.jks

# Environment and secret files
.env
.env.*
*.pem
*.p12
*.mobileprovision

# Native/Flutter generated intermediates
**/ephemeral/
**/.cxx/

# -----------------------------------------------------------------------------
# Local-only：測試、腳本與測試執行檔不上傳
# -----------------------------------------------------------------------------
# 任何層級的 test / tests 資料夾（含 Flutter 的 integration_test、test_driver）
test/
tests/
integration_test/
test_driver/

# 任何層級的 script / scripts 資料夾
script/
scripts/

# 測試用執行檔（Windows 編譯產物）
*.test.exe
*_test.exe
test.exe
tests.exe

# 除錯設定與除錯輸出
/.vscode/
/out/
*.ppm

# 建置產物（任何層級）
**/build/
**/target/
**/.gradle/
**/.cxx/

# 測試用 ROM（第三方程式與商業 ROM，不上傳）
/rom/

